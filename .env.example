# Base de datos. En desarrollo usa SQLite (no requiere instalar nada).
# En producción cambia a Postgres, ej:
# DATABASE_URL="postgresql://usuario:password@host:5432/pereira_emergencia"
DATABASE_URL="file:./dev.db"

# Secreto para firmar las sesiones (JWT). Genera uno único en producción:
#   openssl rand -base64 48
JWT_SECRET="cambia-este-secreto-en-produccion"

# Llaves VAPID para notificaciones push (Web Push).
# Generarlas con: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:projects@allinagencymarketing.com"
