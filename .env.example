# Base de datos Postgres. Gratis y en 1 minuto con https://neon.tech
# (crea un proyecto, copia el "connection string" tal cual aquí).
DATABASE_URL="postgresql://usuario:password@host/pereira_emergencia?sslmode=require"

# Secreto para firmar las sesiones (JWT). Genera uno único en producción:
#   openssl rand -base64 48
JWT_SECRET="cambia-este-secreto-en-produccion"

# Llaves VAPID para notificaciones push (Web Push).
# Generarlas con: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:projects@allinagencymarketing.com"
